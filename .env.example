# Public browser configuration. Use only a Supabase public anon key, never a service-role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Keep backend submission disabled until backend proof and abuse-control approval are complete.
VITE_PINAYMATE_WAITLIST_BACKEND_ENABLED=false
VITE_PINAYMATE_WAITLIST_BACKEND_PROOF_ACCEPTED=false
VITE_PINAYMATE_WAITLIST_ABUSE_CONTROL_APPROVED=false
